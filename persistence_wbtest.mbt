///|
test "json opt helpers cover none branches" {
  let number = @json.parse("1")
  assert_true(number.object_opt() is None)
  assert_true(number.array_opt() is None)
  assert_true(number.string_opt() is None)
  assert_true(number.bool_opt() is None)
  assert_true(number.number_opt() is Some(_))
  let text = @json.parse("\"s\"")
  assert_true(text.object_opt() is None)
  assert_true(text.number_opt() is None)
  assert_true(text.bool_opt() is None)
  assert_true(text.string_opt() is Some(_))
  let flag = @json.parse("true")
  assert_true(flag.object_opt() is None)
  assert_true(flag.array_opt() is None)
  assert_true(flag.number_opt() is None)
  assert_true(flag.string_opt() is None)
  assert_true(flag.bool_opt() is Some(_))
  let array = @json.parse("[]")
  assert_true(array.object_opt() is None)
  assert_true(array.array_opt() is Some(_))
  assert_true(array.bool_opt() is None)
}
